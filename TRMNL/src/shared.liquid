{% template icon %}
<svg width="{{ size | default: 26 }}" height="{{ size | default: 26 }}" viewBox="0 0 24 24" fill="none" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0">
{% case name %}
{% when "mountain" %}
  <path d="M2 21 L9 7 L13.5 14 L16 10.5 L22 21 Z"/>
  <path d="M6.8 11.4 L9 12.5 L11.2 11.4"/>
{% when "valley" %}
  <path d="M1 21 L6.5 5 L12 13 L17.5 5 L23 21"/>
  <path d="M8.5 17.5 L12 14.5 L15.5 17.5" fill="white"/>
  <path d="M9.5 16.8 L9.5 21 L14.5 21 L14.5 16.8" fill="white"/>
  <path d="M1 21 L23 21"/>
{% when "snowflake" %}
  <g><path d="M12 2 V22 M9.5 4.5 L12 7 L14.5 4.5 M9.5 19.5 L12 17 L14.5 19.5"/></g>
  <g transform="rotate(60 12 12)"><path d="M12 2 V22 M9.5 4.5 L12 7 L14.5 4.5 M9.5 19.5 L12 17 L14.5 19.5"/></g>
  <g transform="rotate(120 12 12)"><path d="M12 2 V22 M9.5 4.5 L12 7 L14.5 4.5 M9.5 19.5 L12 17 L14.5 19.5"/></g>
{% when "calendar" %}
  <rect x="3" y="5" width="18" height="16" rx="2"/>
  <path d="M3 10 H21 M8 3 V7 M16 3 V7"/>
  <path d="M12 12.5 V18.5 M9.4 14 L14.6 17 M9.4 17 L14.6 14" stroke-width="1.6"/>
{% when "condition" %}
  <circle cx="10" cy="10" r="7"/>
  <path d="M15 15 L21 21"/>
  <path d="M10 6.5 V13.5 M7 8.2 L13 11.8 M7 11.8 L13 8.2" stroke-width="1.6"/>
{% when "warning" %}
  <path d="M12 3 L22 20 H2 Z"/>
  <path d="M12 9 V14"/>
  <circle cx="12" cy="17" r="0.6" fill="black"/>
{% when "slope" %}
  <circle cx="16" cy="4" r="2" fill="black"/>
  <path d="M14 8 L10 11 L13.5 14 L11 18"/>
  <path d="M14 8 L18 11.5"/>
  <path d="M3 16 L21 22"/>
{% when "lift" %}
  <path d="M2 6 L22 2"/>
  <path d="M12 4 L12 9"/>
  <rect x="6" y="9" width="12" height="12" rx="2"/>
  <path d="M6 14 L18 14"/>
  <path d="M12 14 L12 9"/>
{% endcase %}
</svg>
{% endtemplate %}

{% template show_item %}
{% case id %}
{% when "snow_mountain" %}{% assign item_icon = "mountain" %}
{% when "snow_valley" %}{% assign item_icon = "valley" %}
{% when "new_snow" %}{% assign item_icon = "snowflake" %}
{% else %}{% assign item_icon = nil %}
{% endcase %}
<div class="item">
  <div class="meta"></div>
  <div class="content">
    <span style="display:flex;align-items:center;gap:8px">
      {% if item_icon %}{% render "icon", name: item_icon, size: 30 %}{% endif %}
      {% if value == blank or value == "null" %}
      <span class="value value--tnums value--small i18n-none">none</span>
      {% else %}
      <span class="value value--tnums valu">{{ value }}{{ unit }}</span>
      {% endif %}
    </span>
    <span class="label" id="{{id}}">{{ label }}</span>
  </div>
</div>
{% endtemplate %}

{% template show_item_small %}
{% case id %}
{% when "last_snowfall" %}{% assign small_icon = "calendar" %}
{% when "snow_type" %}{% assign small_icon = "condition" %}
{% when "avalanche_info", "avalanche_info_small" %}{% assign small_icon = "warning" %}
{% else %}{% assign small_icon = nil %}
{% endcase %}
<div class="item">
  <div class="meta"></div>
  <div class="content">
    <span style="display:flex;align-items:center;gap:6px">
      {% if small_icon %}{% render "icon", name: small_icon, size: 22 %}{% endif %}
      <span class="value value--tnums value--small" id="{{id_value}}">{{ value }}</span>
    </span>
    <span class="label" id="{{id}}">{{ label }}</span>
  </div>
</div>
{% endtemplate %}

{% template show_progress %}
<div class="progress-bar progress-bar--small progress-bar--emphasis-2">
  <div class="content">
    <span style="display:flex;align-items:center;gap:6px">
      {% if icon %}{% render "icon", name: icon %}{% endif %}
      <span class="label label" id="{{id}}">{{ label }}</span>
    </span>
    <span class="value value">{{value}}{{unit}}/{{total}}{{unit}}</span>
  </div>
  <div class="track">
    <div class="fill" style="width: {{value | times: 100 | divided_by: total }}%"></div>
  </div>
</div>
{% endtemplate %}

{% template last_snowfall_item %}
  {% assign last = snowfall | split: " " | first %}
  {% render "show_item_small", id: "last_snowfall", value: {{last}} %}
{% endtemplate %}

{% template snow_condition_item %}
  {% render "show_item_small", id: "snow_type",id_value: "snow_type_value", value: {{condition}} %}
{% endtemplate %}

{% template last_update %}
  <span class="title">{{updated_at | date: "%s" | plus: trmnl.user.utc_offset | date: "%d-%m-%Y %H:%M" }}</span>
{% endtemplate %}

{% template translations %}
<script type="text/javascript">
  const translations = {
    pl: {
      slopes_open_count: "Otwarte trasy",
      lifts_open_count:"Otwarte wyciągi",
      snow_mountain: "Góra",
      snow_valley: "Dolina",
      snow_type: "Charakterystyka",
      new_snow: "Nowy śnieg",
      last_snowfall: "Ostatni opad",
      avalanche_info: "Zagrożenie lawinowe",
      avalanche_info_small: "Lawinowe",
      unknown: "nieznane",
      none: "brak"
    },
    en: {
      slopes_open_count: "Open pistes",
      lifts_open_count:"Open lifts",
      snow_mountain: "Mountain",
      snow_valley: "Valley",
      snow_type: "Snow condition",
      new_snow: "New snow",
      last_snowfall: "Latest snowfall",
      avalanche_info: "Avalanche alert",
      avalanche_info_small: "Avalanche",
      unknown: "unknown",
      none: "none"
    },
    de: {
      slopes_open_count: "Offene Pisten",
      lifts_open_count:"Offene Lifte",
      snow_mountain: "Berg",
      snow_valley: "Tal",
      snow_type: "Schneezustand",
      new_snow: "Neuschnee",
      last_snowfall: "Letzter Schneefall",
      avalanche_info: "Lawinenwarnstufe",
      avalanche_info_small: "Lawinenwarnstufe",
      unknown: "unknown",
      none: "keine"
    }
  }
  const locale = "{{locale}}"
  const translation = translations[locale] ?? translations['en']
  for (const [key, value] of Object.entries(translation)) {
    if(document.getElementById(key)) document.getElementById(key).textContent=value
  }
  if(document.getElementById("snow_type_value")?.textContent == 'unknown'){
    document.getElementById("snow_type_value").textContent =translation.unknown
  }
  const avalancheValue = document.getElementById("avalanche_value")
  if(avalancheValue && ['', 'null'].includes(avalancheValue.textContent.trim())){
    avalancheValue.textContent = translation.none
  }
  document.querySelectorAll(".i18n-none").forEach(el => el.textContent = translation.none)
</script>{% endtemplate %}